{
  "name": "chinwag",
  "version": "1.0.0",
  "private": true,
  "description": "Chinwag — self-hosted WhatsApp inbox, REST API and MCP server for AI assistants. By Techtix.",
  "license": "AGPL-3.0-only",
  "workspaces": [
    "server",
    "web",
    "docs"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "npm run dev -w server & npm run dev -w web",
    "build": "npm run build -w web && npm run build -w server",
    "start": "npm run start -w server",
    "test": "npm run test -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w web",
    "db:migrate": "npm run db:migrate -w server",
    "db:deploy": "npm run db:deploy -w server",
    "docs:dev": "npm run dev -w docs",
    "docs:build": "npm run build -w docs"
  },
  "allowScripts": {
    "argon2@0.45.2": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "@scarf/scarf": false,
    "puppeteer": false,
    "fsevents": false,
    "github:pedroslopez/whatsapp-web.js": false,
    "esbuild@0.21.5": true
  },
  "homepage": "https://techtix-uk.github.io/chinwag/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Techtix-UK/chinwag.git"
  }
}
