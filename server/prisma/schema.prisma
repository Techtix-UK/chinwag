// Chinwag — database schema (MySQL / MariaDB)
// All timestamps are stored in UTC. Every WhatsApp-related record references its account.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}

// ───────────────────────────── Users, roles & permissions ─────────────────────────────

model User {
  id                 String    @id @default(cuid())
  email              String    @unique @db.VarChar(191)
  name               String    @db.VarChar(191)
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  timezone           String?   @db.VarChar(64)
  isActive           Boolean   @default(true) @map("is_active")
  failedLoginCount   Int       @default(0) @map("failed_login_count")
  lockedUntil        DateTime? @map("locked_until")
  lastLoginAt        DateTime? @map("last_login_at")
  passwordChangedAt  DateTime  @default(now()) @map("password_changed_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  roles              UserRole[]
  accountPermissions UserAccountPermission[]
  sessions           UserSession[]
  oauthAuthorisations OAuthAuthorisation[]
  oauthRequests      OAuthAuthorizationRequest[]
  drafts             MessageDraft[]
  apiKeysCreated     ApiKey[]  @relation("ApiKeyCreator")

  @@map("users")
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique @db.VarChar(64)
  name        String           @db.VarChar(128)
  description String?          @db.VarChar(512)
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at")
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique @db.VarChar(64)
  description String?          @db.VarChar(512)
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

enum AccountAccessLevel {
  READ
  SEND
  MANAGE
}

model UserAccountPermission {
  userId    String             @map("user_id")
  accountId String             @map("account_id")
  level     AccountAccessLevel
  createdAt DateTime           @default(now()) @map("created_at")
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  account   WhatsappAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([userId, accountId])
  @@index([accountId])
  @@map("user_account_permissions")
}

model UserSession {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  tokenHash   String   @unique @map("token_hash") @db.Char(64)
  csrfToken   String   @map("csrf_token") @db.Char(64)
  ipAddress   String?  @map("ip_address") @db.VarChar(64)
  userAgent   String?  @map("user_agent") @db.VarChar(512)
  createdAt   DateTime @default(now()) @map("created_at")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")
  expiresAt   DateTime @map("expires_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

// ───────────────────────────── WhatsApp accounts ─────────────────────────────

enum AccountStatus {
  INITIALISING
  AWAITING_QR
  AUTHENTICATING
  SYNCHRONISING
  CONNECTED
  DISCONNECTED
  RECONNECTING
  AUTH_FAILED
  SESSION_EXPIRED
  LOGGED_OUT
  ERROR
}

enum DesiredState {
  CONNECTED
  DISCONNECTED
}

model WhatsappAccount {
  id                 String        @id @default(cuid())
  displayName        String        @map("display_name") @db.VarChar(128)
  phoneNumber        String?       @map("phone_number") @db.VarChar(32)
  waId               String?       @map("wa_id") @db.VarChar(128)
  profileName        String?       @map("profile_name") @db.VarChar(191)
  profilePicUrl      String?       @map("profile_pic_url") @db.Text
  platform           String?       @db.VarChar(64)
  status             AccountStatus @default(DISCONNECTED)
  statusDetail       String?       @map("status_detail") @db.VarChar(512)
  desiredState       DesiredState  @default(DISCONNECTED) @map("desired_state")
  lastConnectedAt    DateTime?     @map("last_connected_at")
  lastDisconnectedAt DateTime?     @map("last_disconnected_at")
  lastSyncAt         DateTime?     @map("last_sync_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  session            WhatsappSession?
  userPermissions    UserAccountPermission[]
  contacts           Contact[]
  chats              Chat[]
  messages           Message[]
  attachments        MessageAttachment[]
  scheduledMessages  ScheduledMessage[]
  approvals          MessageApproval[]

  @@map("whatsapp_accounts")
}

model WhatsappSession {
  accountId        String          @id @map("account_id")
  clientId         String          @unique @map("client_id") @db.VarChar(64)
  authPath         String          @map("auth_path") @db.VarChar(512)
  wwebVersion      String?         @map("wweb_version") @db.VarChar(32)
  reconnectAttempts Int            @default(0) @map("reconnect_attempts")
  lastError        String?         @map("last_error") @db.Text
  lastQrAt         DateTime?       @map("last_qr_at")
  lastReadyAt      DateTime?       @map("last_ready_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  account          WhatsappAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("whatsapp_sessions")
}

// ───────────────────────────── Contacts ─────────────────────────────

model Contact {
  id              String          @id @default(cuid())
  accountId       String          @map("account_id")
  waId            String          @map("wa_id") @db.VarChar(128)
  phoneNumber     String?         @map("phone_number") @db.VarChar(32)
  displayName     String?         @map("display_name") @db.VarChar(191)
  profileName     String?         @map("profile_name") @db.VarChar(191)
  profilePicUrl   String?         @map("profile_pic_url") @db.Text
  isBusiness      Boolean         @default(false) @map("is_business")
  isEnterprise    Boolean         @default(false) @map("is_enterprise")
  isMyContact     Boolean         @default(false) @map("is_my_contact")
  isGroup         Boolean         @default(false) @map("is_group")
  isBlocked       Boolean         @default(false) @map("is_blocked")
  lastInteractionAt DateTime?     @map("last_interaction_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  account         WhatsappAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  notes           ContactNote[]
  tags            ContactTag[]

  @@unique([accountId, waId])
  @@index([accountId, displayName])
  @@index([accountId, phoneNumber])
  @@map("contacts")
}

model ContactNote {
  id        String   @id @default(cuid())
  contactId String   @map("contact_id")
  authorId  String?  @map("author_id")
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@map("contact_notes")
}

model ContactTag {
  contactId String   @map("contact_id")
  tag       String   @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([contactId, tag])
  @@index([tag])
  @@map("contact_tags")
}

// ───────────────────────────── Chats & messages ─────────────────────────────

enum SyncState {
  FULL
  PARTIAL
  UNAVAILABLE
}

model Chat {
  id                 String          @id @default(cuid())
  accountId          String          @map("account_id")
  waChatId           String          @map("wa_chat_id") @db.VarChar(128)
  name               String?         @db.VarChar(191)
  isGroup            Boolean         @default(false) @map("is_group")
  isArchived         Boolean         @default(false) @map("is_archived")
  isPinned           Boolean         @default(false) @map("is_pinned")
  isMuted            Boolean         @default(false) @map("is_muted")
  isReadOnly         Boolean         @default(false) @map("is_read_only")
  unreadCount        Int             @default(0) @map("unread_count")
  profilePicUrl      String?         @map("profile_pic_url") @db.Text
  groupDescription   String?         @map("group_description") @db.Text
  groupOwner         String?         @map("group_owner") @db.VarChar(128)
  groupCreatedAt     DateTime?       @map("group_created_at")
  lastMessageAt      DateTime?       @map("last_message_at")
  lastMessagePreview String?         @map("last_message_preview") @db.VarChar(255)
  lastMessageFromMe  Boolean?        @map("last_message_from_me")
  syncState          SyncState       @default(UNAVAILABLE) @map("sync_state")
  syncedMessageCount Int             @default(0) @map("synced_message_count")
  lastSyncedAt       DateTime?       @map("last_synced_at")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")
  account            WhatsappAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  messages           Message[]
  participants       GroupParticipant[]
  drafts             MessageDraft[]

  @@unique([accountId, waChatId])
  @@index([accountId, lastMessageAt])
  @@index([accountId, unreadCount])
  @@index([accountId, name])
  @@map("chats")
}

model GroupParticipant {
  chatId       String   @map("chat_id")
  accountId    String   @map("account_id")
  waId         String   @map("wa_id") @db.VarChar(128)
  isAdmin      Boolean  @default(false) @map("is_admin")
  isSuperAdmin Boolean  @default(false) @map("is_super_admin")
  updatedAt    DateTime @updatedAt @map("updated_at")
  chat         Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@id([chatId, waId])
  @@index([accountId])
  @@map("group_participants")
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  PENDING
  SENDING
  SENT
  DELIVERED
  READ
  PLAYED
  FAILED
  RECEIVED
}

model Message {
  id               String           @id @default(cuid())
  accountId        String           @map("account_id")
  chatId           String           @map("chat_id")
  waMessageId      String           @map("wa_message_id") @db.VarChar(255)
  direction        MessageDirection
  type             String           @db.VarChar(48)
  body             String?          @db.Text
  senderWaId       String?          @map("sender_wa_id") @db.VarChar(128)
  senderName       String?          @map("sender_name") @db.VarChar(191)
  status           MessageStatus    @default(RECEIVED)
  ack              Int?
  timestamp        DateTime
  hasMedia         Boolean          @default(false) @map("has_media")
  quotedWaMessageId String?         @map("quoted_wa_message_id") @db.VarChar(255)
  quotedBody       String?          @map("quoted_body") @db.VarChar(512)
  isForwarded      Boolean          @default(false) @map("is_forwarded")
  isEdited         Boolean          @default(false) @map("is_edited")
  editedAt         DateTime?        @map("edited_at")
  isDeleted        Boolean          @default(false) @map("is_deleted")
  deletedAt        DateTime?        @map("deleted_at")
  locationLat      Float?           @map("location_lat")
  locationLng      Float?           @map("location_lng")
  locationName     String?          @map("location_name") @db.VarChar(255)
  sentByUserId     String?          @map("sent_by_user_id")
  sentVia          String?          @map("sent_via") @db.VarChar(32)
  errorDetail      String?          @map("error_detail") @db.VarChar(512)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  account          WhatsappAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  chat             Chat             @relation(fields: [chatId], references: [id], onDelete: Cascade)
  attachments      MessageAttachment[]
  reactions        MessageReaction[]

  @@unique([accountId, waMessageId])
  @@index([chatId, timestamp])
  @@index([accountId, timestamp])
  @@index([accountId, direction, timestamp])
  @@map("messages")
}

enum MediaState {
  PENDING
  STORED
  NOT_DOWNLOADED
  FAILED
  DELETED
}

model MessageAttachment {
  id               String          @id @default(cuid())
  accountId        String          @map("account_id")
  messageId        String?         @map("message_id")
  originalFilename String?         @map("original_filename") @db.VarChar(255)
  storagePath      String?         @map("storage_path") @db.VarChar(512)
  mimeType         String          @map("mime_type") @db.VarChar(128)
  sizeBytes        Int?            @map("size_bytes")
  checksum         String?         @db.Char(64)
  state            MediaState      @default(PENDING)
  source           String          @default("whatsapp") @db.VarChar(32)
  uploadedByUserId String?         @map("uploaded_by_user_id")
  createdAt        DateTime        @default(now()) @map("created_at")
  account          WhatsappAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  message          Message?        @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([accountId, createdAt])
  @@index([messageId])
  @@map("message_attachments")
}

model MessageReaction {
  id          String   @id @default(cuid())
  messageId   String   @map("message_id")
  accountId   String   @map("account_id")
  senderWaId  String   @map("sender_wa_id") @db.VarChar(128)
  emoji       String   @db.VarChar(32)
  timestamp   DateTime
  message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, senderWaId])
  @@index([accountId])
  @@map("message_reactions")
}

model MessageDraft {
  userId    String   @map("user_id")
  chatId    String   @map("chat_id")
  body      String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@id([userId, chatId])
  @@map("message_drafts")
}

// ───────────────────────────── Scheduling & approvals ─────────────────────────────

enum ScheduledStatus {
  PENDING
  AWAITING_APPROVAL
  PROCESSING
  SENT
  FAILED
  CANCELLED
  EXPIRED
  DELIVERY_UNCERTAIN
}

model ScheduledMessage {
  id              String           @id @default(cuid())
  accountId       String           @map("account_id")
  recipientWaId   String           @map("recipient_wa_id") @db.VarChar(128)
  recipientLabel  String?          @map("recipient_label") @db.VarChar(191)
  body            String?          @db.Text
  attachmentId    String?          @map("attachment_id")
  scheduledAt     DateTime         @map("scheduled_at")
  timezone        String           @db.VarChar(64)
  status          ScheduledStatus  @default(PENDING)
  approvalStatus  String           @default("NOT_REQUIRED") @map("approval_status") @db.VarChar(32)
  approvalId      String?          @map("approval_id")
  createdByType   String           @map("created_by_type") @db.VarChar(32)
  createdById     String           @map("created_by_id") @db.VarChar(64)
  createdByLabel  String?          @map("created_by_label") @db.VarChar(191)
  attempts        Int              @default(0)
  lastAttemptAt   DateTime?        @map("last_attempt_at")
  errorDetail     String?          @map("error_detail") @db.Text
  sentMessageId   String?          @map("sent_message_id") @db.VarChar(255)
  sentAt          DateTime?        @map("sent_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  account         WhatsappAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@index([accountId, status])
  @@map("scheduled_messages")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUPERSEDED
  EXECUTED
  FAILED
}

model MessageApproval {
  id               String          @id @default(cuid())
  accountId        String          @map("account_id")
  kind             String          @db.VarChar(32)
  recipientWaId    String          @map("recipient_wa_id") @db.VarChar(128)
  recipientLabel   String?         @map("recipient_label") @db.VarChar(191)
  payload          Json
  payloadHash      String          @map("payload_hash") @db.Char(64)
  scheduledMessageId String?       @map("scheduled_message_id")
  status           ApprovalStatus  @default(PENDING)
  /// dashboard = approved by a reviewer; client = confirmed by the requesting user in the MCP client; either = both allowed
  confirmMode      String          @default("dashboard") @map("confirm_mode") @db.VarChar(16)
  expiresAt        DateTime?       @map("expires_at")
  requestedByType  String          @map("requested_by_type") @db.VarChar(32)
  requestedById    String          @map("requested_by_id") @db.VarChar(64)
  requestedByLabel String?         @map("requested_by_label") @db.VarChar(191)
  decidedByUserId  String?         @map("decided_by_user_id")
  decisionNote     String?         @map("decision_note") @db.VarChar(512)
  decidedAt        DateTime?       @map("decided_at")
  resultMessageId  String?         @map("result_message_id") @db.VarChar(255)
  errorDetail      String?         @map("error_detail") @db.Text
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  account          WhatsappAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([accountId, status])
  @@map("message_approvals")
}

// ───────────────────────────── Integrations ─────────────────────────────

enum ApprovalPolicy {
  READ_ONLY
  REQUIRE_APPROVAL
  CONFIRM_IN_CHAT
  CONFIRM_IN_CHAT_OR_DASHBOARD
  DIRECT
}

model ApiKey {
  id              String         @id @default(cuid())
  name            String         @db.VarChar(128)
  prefix          String         @unique @db.VarChar(32)
  keyHash         String         @unique @map("key_hash") @db.Char(64)
  scopes          Json
  accountIds      Json           @map("account_ids")
  allAccounts     Boolean        @default(false) @map("all_accounts")
  approvalPolicy  ApprovalPolicy @default(REQUIRE_APPROVAL) @map("approval_policy")
  expiresAt       DateTime?      @map("expires_at")
  lastUsedAt      DateTime?      @map("last_used_at")
  lastUsedIp      String?        @map("last_used_ip") @db.VarChar(64)
  revokedAt       DateTime?      @map("revoked_at")
  rotatedFromId   String?        @map("rotated_from_id")
  createdById     String?        @map("created_by_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  createdBy       User?          @relation("ApiKeyCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@map("api_keys")
}

model OAuthClient {
  id                      String   @id @default(cuid())
  clientId                String   @unique @map("client_id") @db.VarChar(255)
  clientSecretEnc         String?  @map("client_secret_enc") @db.Text
  clientSecretExpiresAt   Int?     @map("client_secret_expires_at")
  clientName              String?  @map("client_name") @db.VarChar(255)
  clientUri               String?  @map("client_uri") @db.VarChar(512)
  logoUri                 String?  @map("logo_uri") @db.VarChar(512)
  redirectUris            Json     @map("redirect_uris")
  grantTypes              Json     @map("grant_types")
  responseTypes           Json     @map("response_types")
  tokenEndpointAuthMethod String   @default("none") @map("token_endpoint_auth_method") @db.VarChar(64)
  scope                   String?  @db.VarChar(1024)
  registrationType        String   @default("dynamic") @map("registration_type") @db.VarChar(32)
  metadata                Json?
  disabled                Boolean  @default(false)
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")
  authorisations          OAuthAuthorisation[]

  @@map("oauth_clients")
}

model OAuthAuthorizationRequest {
  id            String      @id @db.Char(43)
  clientId      String      @map("client_id") @db.VarChar(255)
  redirectUri   String      @map("redirect_uri") @db.Text
  codeChallenge String      @map("code_challenge") @db.VarChar(128)
  state         String?     @db.Text
  scopes        Json
  resource      String?     @db.VarChar(512)
  userId        String?     @map("user_id")
  consumedAt    DateTime?   @map("consumed_at")
  expiresAt     DateTime    @map("expires_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  user          User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("oauth_authorization_requests")
}

model OAuthAuthorisation {
  id             String         @id @default(cuid())
  clientDbId     String         @map("client_db_id")
  userId         String         @map("user_id")
  scopes         Json
  accountIds     Json           @map("account_ids")
  approvalPolicy ApprovalPolicy @default(REQUIRE_APPROVAL) @map("approval_policy")
  lastUsedAt     DateTime?      @map("last_used_at")
  lastError      String?        @map("last_error") @db.VarChar(512)
  lastErrorAt    DateTime?      @map("last_error_at")
  revokedAt      DateTime?      @map("revoked_at")
  revokedReason  String?        @map("revoked_reason") @db.VarChar(255)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  client         OAuthClient    @relation(fields: [clientDbId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokens         OAuthToken[]

  @@index([clientDbId])
  @@index([userId])
  @@map("oauth_authorisations")
}

enum OAuthTokenType {
  AUTHORIZATION_CODE
  ACCESS
  REFRESH
}

model OAuthToken {
  id              String             @id @default(cuid())
  authorisationId String             @map("authorisation_id")
  type            OAuthTokenType
  tokenHash       String             @unique @map("token_hash") @db.Char(64)
  scopes          Json
  resource        String?            @db.VarChar(512)
  codeChallenge   String?            @map("code_challenge") @db.VarChar(128)
  redirectUri     String?            @map("redirect_uri") @db.Text
  parentId        String?            @map("parent_id")
  usedAt          DateTime?          @map("used_at")
  revokedAt       DateTime?          @map("revoked_at")
  expiresAt       DateTime           @map("expires_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  authorisation   OAuthAuthorisation @relation(fields: [authorisationId], references: [id], onDelete: Cascade)

  @@index([authorisationId, type])
  @@index([expiresAt])
  @@map("oauth_tokens")
}

model IdempotencyKey {
  id          String   @id @default(cuid())
  principal   String   @db.VarChar(96)
  key         String   @db.VarChar(191)
  requestHash String   @map("request_hash") @db.Char(64)
  state       String   @db.VarChar(16)
  statusCode  Int?     @map("status_code")
  response    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([principal, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

// ───────────────────────────── Webhooks ─────────────────────────────

model Webhook {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(128)
  url         String   @db.VarChar(1024)
  events      Json
  accountIds  Json     @map("account_ids")
  allAccounts Boolean  @default(true) @map("all_accounts")
  secretEnc   String   @map("secret_enc") @db.Text
  enabled     Boolean  @default(true)
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deliveries  WebhookDelivery[]

  @@map("webhooks")
}

enum DeliveryStatus {
  PENDING
  DELIVERING
  SUCCEEDED
  FAILED
  RETRYING
}

model WebhookDelivery {
  id             String         @id @default(cuid())
  webhookId      String         @map("webhook_id")
  event          String         @db.VarChar(64)
  eventId        String         @map("event_id") @db.VarChar(64)
  accountId      String?        @map("account_id")
  payload        Json
  status         DeliveryStatus @default(PENDING)
  attempts       Int            @default(0)
  nextAttemptAt  DateTime       @default(now()) @map("next_attempt_at")
  responseStatus Int?           @map("response_status")
  responseBody   String?        @map("response_body") @db.VarChar(1024)
  errorDetail    String?        @map("error_detail") @db.VarChar(1024)
  durationMs     Int?           @map("duration_ms")
  deliveredAt    DateTime?      @map("delivered_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  webhook        Webhook        @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([webhookId, createdAt])
  @@map("webhook_deliveries")
}

// ───────────────────────────── Logs & settings ─────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  timestamp  DateTime @default(now())
  action     String   @db.VarChar(96)
  actorType  String   @map("actor_type") @db.VarChar(32)
  actorId    String?  @map("actor_id") @db.VarChar(64)
  actorLabel String?  @map("actor_label") @db.VarChar(191)
  source     String   @db.VarChar(32)
  accountId  String?  @map("account_id") @db.VarChar(32)
  result     String   @db.VarChar(16)
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  metadata   Json?

  @@index([timestamp])
  @@index([action, timestamp])
  @@index([accountId, timestamp])
  @@index([actorId, timestamp])
  @@map("audit_logs")
}

model SystemEvent {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  level     String   @db.VarChar(16)
  component String   @db.VarChar(64)
  accountId String?  @map("account_id") @db.VarChar(32)
  message   String   @db.VarChar(1024)
  detail    Json?

  @@index([timestamp])
  @@index([level, timestamp])
  @@map("system_events")
}

model ApplicationSetting {
  key       String   @id @db.VarChar(96)
  value     Json
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("application_settings")
}
