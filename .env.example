# ───────────────────────── Techtix WhatsApp — environment configuration ─────────────────────────
# Sensitive deployment settings live here, NOT in the settings database.
# Copy to /opt/techtix-whatsapp/.env, chmod 600, owned by the service user.

NODE_ENV=production

# Public base URL (HTTPS). Used for OAuth issuer, MCP resource URL, cookie security and links.
BASE_URL=https://whatsapp.techtixglobal.com

# Internal HTTP server. Bind to localhost when behind Apache/Nginx.
HOST=127.0.0.1
PORT=3100

# Number of reverse proxies in front of the app (for correct client IPs / HTTPS detection).
TRUST_PROXY=1

# MySQL / MariaDB connection. Database must use utf8mb4.
DATABASE_URL=mysql://techtix_whatsapp:CHANGE_ME@127.0.0.1:3306/techtix_whatsapp

# Persistent data directory (sessions, media, setup token). Must be writable only by the service user.
DATA_DIR=/var/lib/techtix-whatsapp

# 32-byte key (base64 or 64 hex chars) used for AES-256-GCM encryption of stored credentials
# (webhook signing secrets, OAuth client secrets). Generate with: openssl rand -base64 32
# Losing this key makes stored secrets unrecoverable. Back it up separately from the database.
APP_ENCRYPTION_KEY=

# One-time installation token for the setup wizard. Generated by install.sh.
# If empty, a token is generated at first start and written to $DATA_DIR/setup-token (mode 0600).
SETUP_TOKEN=

# Chromium executable used by Puppeteer (Debian: /usr/bin/chromium).
CHROMIUM_PATH=/usr/bin/chromium

# Chromium sandboxing is preserved by default. Only set to true if the kernel does not support
# unprivileged user namespaces and you accept the reduced isolation.
CHROMIUM_DISABLE_SANDBOX=false

# Maximum number of Chromium instances that may start simultaneously.
CHROMIUM_START_CONCURRENCY=2

# Allow webhook destinations on localhost/private networks (secure deployment policy).
# Comma-separated CIDR list, e.g. 10.0.5.0/24. Empty = all private/reserved ranges are blocked.
WEBHOOK_ALLOWED_PRIVATE_CIDRS=

# Log level: error | warn | info | debug
LOG_LEVEL=info
